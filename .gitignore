/target
# The Linux release build runs in a container (natively, not cross-compiled)
# and writes here as root.
/target-linux-release
/dist
/.kaeru-vault/
*.swp
.DS_Store
.idea/
.vscode/
.intentionally-empty-file.*

# Offline build: fetched by contrib/offline/fetch-vendor.sh, never committed
# here — the vendor tree lives in LamantinAI/kaeru-vendor, one tag per release.
/vendor/
/.cargo/config.toml

# Python support-script tests
__pycache__/
